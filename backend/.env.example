# Copie para backend/.env e preencha

# Chave da API Groq (opcional — sem chave, respostas usam fallback determinístico)
# Modelos: openai/gpt-oss-20b (DM, cenas, conversas) e openai/gpt-oss-120b (posts de NPCs)
GROQ_API_KEY=

# Segredo do JWT (obrigatório em produção; em dev usa o default)
JWT_SECRET=troque-este-segredo-em-producao

# Banco (default: sqlite:///../data/app.db relativo ao backend/)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/viva

# CORS (separado por vírgula)
CORS_ORIGINS=http://localhost:5173

# Auto-migração no startup (true/false)
AUTO_MIGRATE=true
